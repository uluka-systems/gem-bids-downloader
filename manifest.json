{
    "manifest_version": 3,
    "name": "Auto Search & Download",
    "version": "1.0",
    "description": "Paste a list and download result for each item.",
    "permissions": ["scripting", "activeTab", "downloads"],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Auto Downloader"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "host_permissions": ["<all_urls>"]
  }
